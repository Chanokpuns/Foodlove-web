<body>
    <div class="colorBar"></div>


    <div class="topall">
        <div class="logoonanother">
            <div class="nameforanother">Food'ove</div>
        </div>

        <div class="firstnav">
            <a href="/cart" class="cartbutton">Cart</a>
            <a href="/login" class="loginbutton">Login</a>
            <a href="/profile" class="profilebutton">Profile</a>
        </div>
    </div>



    <div class="form">
        <h1 class="loginname">Login</h1>

        <form action="/menu" method="post">

            <div class="inputrow">
                <label for="username">Username :</label>
                <input type="text" id="username" >
            </div>

            <div class="inputrow">
                <label for="password">Password :</label>
                <input type="password" id="password" required minlength="10">
            </div>

            <div class="topall2">
                <a href="/register" class="register1">Register</a>

                <button type="submit" class="submit1">
                    Submit
                </button>
            </div>

        </form>
    </div>


</body>

