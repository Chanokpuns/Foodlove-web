<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register</title>

    <link rel="stylesheet" href="styles.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Mali:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
        rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Changa+One:ital@0;1&display=swap" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Akt:wght@100..900&display=swap" rel="stylesheet">
</head>


<body>

    <div class="colorBar"></div>


    <div class="topall">
        <div class="logoonanother">
            <div class="nameforanother">Food'ove</div>
        </div>

        <div class="firstnav">
            <a href="/cart" class="cartbutton">Cart</a>
            <a href="/login" class="loginbutton">Login</a>
            <a href="/profile" class="profilebutton">Profile</a>
        </div>
    </div>

    
    <div class="form">
        <h1 class="loginname">Register</h1>
        <form action="/menu" method="post">

            <div class="inputrow">
                <label for="username">Username :</label>
                <input type="text" id="username" >
            </div>

            <div class="inputrow">
                <label for="password">Password :</label>
                <input type="password" id="password" required minlength="10">
            </div>

            <div class="inputrow">
                <label for="email">Email :</label>
                <input type="email" id="email" placeholder="hahah@gmail.com">
            </div>

            <div class="inputrow">
                <label for="phone">Phone :</label>
                <input type="text" id="phone" placeholder="e.g.555-555-5555" pattern="/d{3}-/d{3}-/d{4}">
            </div>

            <div class="topall3">
                <a href="/submit" class="submit1">Submit</a>
            </div>

        </form>
    </div>

</body>
</html>