<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chicken</title>

    <link rel="stylesheet" href="/css/chicken.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Mali:ital,wght@0,200;0,300;0,400;0,500;0,600;0,700;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
        rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Changa+One:ital@0;1&display=swap" rel="stylesheet">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Akt:wght@100..900&display=swap" rel="stylesheet">
</head>


<body>

    <div class="colorBar"></div>

    <div class="topall">
        <div class="logoonanother">
            <div class="nameforanother">Food'ove</div>
        </div>

        <div class="firstnav">
            <a href="/" class="cartbutton">Home</a>
            <a href="/cart" class="cartbutton">Cart</a>
             <a href="/#menu" class="cartbutton">Menu</a>
        </div>
    </div>

    <div class="name-menu">
        <h1>Chicken-Menu</h1>
    </div>


    <div class="show-menu">
        <% chickens.forEach(chicken=> { %>
            <div class="chicken-card">
                <img src="<%= chicken.image %>">
                <p>
                    <%= chicken.name %>
                </p>
                <p>฿ <%= chicken.price %>
                </p>
                <div class="quantity">
                    <button type="button" class="minus">−</button>

                    <span class="quantity-number">0</span>

                    <button type="button" class="plus">+</button>
                </div>
                <button class="add-button add-cart" data-id="<%= chicken.id %>" data-name="<%= chicken.name %>"
                    data-price="<%= chicken.price %>">
                    Add to Cart
                </button>
            </div>
            <% }) %>
    </div>


    <!-- JavaScript สำหรับ + - -->
    <script>
        document.querySelectorAll(".chicken-card").forEach(card => {

        let quantity = 0;
        const minus = card.querySelector(".minus");
        const plus = card.querySelector(".plus");
        const quantityNumber = card.querySelector(".quantity-number");
        const addCart = card.querySelector(".add-cart");

        // เพิ่มจำนวน
        plus.addEventListener("click", () => {
            quantity++;
            quantityNumber.textContent = quantity;
        });

        // ลดจำนวน
        minus.addEventListener("click", () => {
            if (quantity > 0) {
                quantity--;
                quantityNumber.textContent = quantity;
            }
        });

        // Add to Cart
        addCart.addEventListener("click", () => {
            if (quantity === 0) {
                alert("Please select quantity.");
                return;
            }

            let cart = JSON.parse(localStorage.getItem("cart")) || [];

            const id = addCart.dataset.id;
            const name = addCart.dataset.name;
            const price = Number(addCart.dataset.price);

            // เช็คว่าสินค้านี้มีอยู่ใน Cart ยัง
            const existingItem = cart.find(item => item.id === id);
            if (existingItem) {
                existingItem.quantity += quantity;
            } else {
                cart.push({
                    id: id,
                    name: name,
                    price: price,
                    quantity: quantity
                });
            }
            // บันทึก Cart
            localStorage.setItem("cart", JSON.stringify(cart));
            alert("Added to cart!");

            // reset จำนวน
            quantity = 0;
            quantityNumber.textContent = 0;
            });
        });
    </script>
</body>

</html>