        <h2 class="section-title menu-title">Menu</h2>

        <div class="menu">
            <a href="/pizza" class="menu-button">Pizza</a>
            <a href="/hamburger" class="menu-button">Hamburger</a>
            <a href="/chicken" class="menu-button">Chicken</a>
            <a href="/drink" class="menu-button">Drinks</a>
        </div>

    </section>

    <!-- Contact -->
    <section class="contact-section">
        <div class="contact">
            <p>Email: cseemaphon@gmail.com</p>
        </div>
